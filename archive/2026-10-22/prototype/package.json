{
    "name":  "barracks",
    "version":  "0.1.0",
    "private":  true,
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=24.5.0"
                },
    "scripts":  {
                    "dev": "powershell -NoProfile -File scripts/factory.ps1 dev",
                    "build": "powershell -NoProfile -File scripts/factory.ps1 build",
                    "check": "powershell -NoProfile -File scripts/factory.ps1 check",
                    "test": "powershell -NoProfile -File scripts/factory.ps1 verify",
                    "check:prototype": "tsc --noEmit",
                    "test:prototype": "node --experimental-strip-types --test test/*.test.ts",
                    "qualify":  "node --experimental-strip-types src/qualify.ts",
                    "qualify:protocol":  "node --experimental-strip-types src/qualify-protocol.ts",
                    "qualify:process":  "node --experimental-strip-types src/qualify-process.ts",
                    "qualify:isolation-control":  "node --experimental-strip-types src/qualify-isolation-control.ts",
                    "qualify:isolation":  "node --experimental-strip-types src/qualify-isolation.ts"
                },
    "dependencies":  {
                         "@mastra/core":  "1.79.0",
                         "@mastra/libsql":  "1.27.0",
                         "zod":  "4.6.7"
                     },
    "devDependencies":  {
                            "@types/node":  "24.19.2",
                            "typescript":  "7.0.2"
                        }
}
