{
  "schemaVersion": 3,
  "id": "grilling",
  "name": "Product discovery / grilling",
  "description": "Develop and challenge a brief, review its specification, then review tickets. PMT publication is a manual checkpoint in this starting definition.",
  "inputs": [
    "task",
    "project"
  ],
  "initial": "develop_brief",
  "states": {
    "develop_brief": {
      "type": "agent",
      "persona": "product-owner",
      "instructions": "Apply grilling to develop or revise the brief from the task, project context, answers and Architect challenges. Resolve established intent and ask about missing product decisions.",
      "inputs": [
        "task",
        "project"
      ],
      "optionalInputs": [
        "brief",
        "challenges",
        "answers"
      ],
      "on": {
        "brief_ready": {
          "target": "challenge",
          "outputs": [
            "brief"
          ],
          "clear": [
            "specification",
            "specification_approval",
            "ticket_plan",
            "ticket_breakdown",
            "ticket_approval",
            "epic",
            "tickets"
          ]
        },
        "needs_user": {
          "target": "await_develop_brief",
          "outputs": [
            "questions"
          ]
        }
      }
    },
    "challenge": {
      "type": "agent",
      "persona": "architect",
      "instructions": "Challenge the brief with concrete scenarios, constraints and test seams using grilling and codebase-design. Agree when discovery is settled; request revision when reasoning is incomplete.",
      "inputs": [
        "task",
        "project",
        "brief"
      ],
      "optionalInputs": [
        "answers"
      ],
      "on": {
        "needs_revision": {
          "target": "develop_brief",
          "outputs": [
            "challenges"
          ],
          "clear": [
            "specification",
            "specification_approval",
            "ticket_plan",
            "ticket_breakdown",
            "ticket_approval",
            "epic",
            "tickets"
          ]
        },
        "brief_agreed": {
          "target": "specify",
          "outputs": [
            "technical_decisions"
          ]
        },
        "needs_user": {
          "target": "await_challenge",
          "outputs": [
            "questions"
          ]
        }
      }
    },
    "specify": {
      "type": "agent",
      "persona": "architect",
      "instructions": "Apply to-spec to synthesize agreed discovery into behavior, boundaries, decisions, acceptance criteria and high-level test seams. Preserve glossary and ADR proposals. Reopen discovery when scope changes.",
      "inputs": [
        "task",
        "project",
        "brief",
        "technical_decisions"
      ],
      "optionalInputs": [
        "specification",
        "specification_feedback",
        "answers"
      ],
      "on": {
        "specification_ready": {
          "target": "review_specification",
          "outputs": [
            "specification"
          ],
          "clear": [
            "specification_approval",
            "ticket_plan",
            "ticket_breakdown",
            "ticket_approval",
            "epic",
            "tickets"
          ]
        },
        "needs_revision": {
          "target": "develop_brief",
          "outputs": [
            "challenges"
          ],
          "clear": [
            "specification",
            "specification_approval",
            "ticket_plan",
            "ticket_breakdown",
            "ticket_approval",
            "epic",
            "tickets"
          ]
        },
        "needs_user": {
          "target": "await_specify",
          "outputs": [
            "questions"
          ]
        }
      }
    },
    "review_specification": {
      "type": "human",
      "instructions": "Review the specification, scope and test seams. Approve to plan tickets, or request changes.",
      "inputs": [
        "specification"
      ],
      "on": {
        "approved": {
          "target": "create_tickets",
          "outputs": [
            "specification_approval"
          ]
        },
        "changes": {
          "target": "specify",
          "outputs": [
            "specification_feedback"
          ],
          "clear": [
            "specification_approval",
            "ticket_plan",
            "ticket_breakdown",
            "ticket_approval",
            "epic",
            "tickets"
          ]
        }
      }
    },
    "create_tickets": {
      "type": "agent",
      "persona": "project-manager",
      "instructions": "Apply to-tickets to draft self-contained tracer-bullet vertical slices with observable acceptance criteria, verification and real blocking dependencies. Preserve approved scope. Return ticket_plan as {epic:{title,description},tickets:[{title,description,acceptanceCriteria,dependsOn}]}; dependsOn contains zero-based indexes of earlier tickets. Include a readable ticket_breakdown.",
      "inputs": [
        "task",
        "project",
        "brief",
        "specification",
        "specification_approval"
      ],
      "optionalInputs": [
        "ticket_feedback",
        "answers"
      ],
      "on": {
        "tickets_ready": {
          "target": "review_tickets",
          "outputs": [
            "ticket_plan",
            "ticket_breakdown"
          ],
          "clear": [
            "ticket_approval",
            "epic",
            "tickets"
          ]
        },
        "needs_revision": {
          "target": "specify",
          "outputs": [
            "specification_feedback"
          ],
          "clear": [
            "specification_approval",
            "ticket_plan",
            "ticket_breakdown",
            "ticket_approval",
            "epic",
            "tickets"
          ]
        },
        "needs_user": {
          "target": "await_create_tickets",
          "outputs": [
            "questions"
          ]
        }
      }
    },
    "review_tickets": {
      "type": "human",
      "instructions": "Review ticket scope, slice size and dependencies. Approve the plan for publication, or request changes.",
      "inputs": [
        "specification",
        "ticket_plan",
        "ticket_breakdown"
      ],
      "on": {
        "approved": {
          "target": "publish_tickets",
          "outputs": [
            "ticket_approval"
          ]
        },
        "changes": {
          "target": "create_tickets",
          "outputs": [
            "ticket_feedback"
          ],
          "clear": [
            "ticket_approval",
            "epic",
            "tickets"
          ]
        }
      }
    },
    "publish_tickets": {
      "type": "human",
      "instructions": "Publish the approved plan to PMT using your available tools, then provide the actual epic and ticket references. This checkpoint confirms completed publication.",
      "inputs": [
        "specification",
        "specification_approval",
        "ticket_plan",
        "ticket_approval"
      ],
      "on": {
        "published": {
          "target": "complete",
          "outputs": [
            "epic",
            "tickets"
          ]
        },
        "changes": {
          "target": "create_tickets",
          "outputs": [
            "ticket_feedback"
          ],
          "clear": [
            "ticket_approval",
            "epic",
            "tickets"
          ]
        }
      }
    },
    "await_develop_brief": {
      "type": "human",
      "instructions": "Answer the questions from develop_brief. Your answer returns to that state; it does not approve its work.",
      "inputs": [
        "questions"
      ],
      "on": {
        "answered": {
          "target": "develop_brief",
          "outputs": [
            "answers"
          ],
          "clear": [
            "questions"
          ]
        }
      }
    },
    "await_challenge": {
      "type": "human",
      "instructions": "Answer the questions from challenge. Your answer returns to that state; it does not approve its work.",
      "inputs": [
        "questions"
      ],
      "on": {
        "answered": {
          "target": "challenge",
          "outputs": [
            "answers"
          ],
          "clear": [
            "questions"
          ]
        }
      }
    },
    "await_specify": {
      "type": "human",
      "instructions": "Answer the questions from specify. Your answer returns to that state; it does not approve its work.",
      "inputs": [
        "questions"
      ],
      "on": {
        "answered": {
          "target": "specify",
          "outputs": [
            "answers"
          ],
          "clear": [
            "questions"
          ]
        }
      }
    },
    "await_create_tickets": {
      "type": "human",
      "instructions": "Answer the questions from create_tickets. Your answer returns to that state; it does not approve its work.",
      "inputs": [
        "questions"
      ],
      "on": {
        "answered": {
          "target": "create_tickets",
          "outputs": [
            "answers"
          ],
          "clear": [
            "questions"
          ]
        }
      }
    },
    "complete": {
      "type": "final",
      "inputs": [
        "specification",
        "epic",
        "tickets"
      ],
      "message": "Specification and published tickets are ready. Start delivery separately."
    }
  }
}
