{
  "name": "barracks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node --experimental-strip-types server/index.ts",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "build": "npm run check && vite build",
    "qualify:codex": "npm run test:real",
    "test:browser": "playwright test e2e/dashboard.spec.ts e2e/projects.spec.ts e2e/workflows.spec.ts",
    "test:projects": "node --experimental-strip-types scripts/project-browser.ts",
    "test:library": "node --experimental-strip-types scripts/library-browser.ts",
    "test:new-project": "node --experimental-strip-types scripts/new-project-real.ts",
    "test:real": "node --experimental-strip-types scripts/factory-real.ts",
    "test:recovery": "node --experimental-strip-types scripts/real-recovery.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
