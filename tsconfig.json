{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "noEmit": true, "allowImportingTsExtensions": true,"erasableSyntaxOnly":true,
    "types": ["node", "vite/client"]
  },
  "include": ["server", "shared", "web", "test", "e2e", "scripts/**/*.ts", "vite.config.ts", "playwright.config.ts"]
}
