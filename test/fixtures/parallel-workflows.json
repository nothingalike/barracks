[
    {
        "schemaVersion":  2,
        "id":  "parallel-delivery",
        "name":  "Epic delivery with parallel worktrees",
        "kind":  "delivery",
        "description":  "Dependency-ready tickets use isolated Git worktrees, pass independent review, and join a Lead-approved integration candidate. Final acceptance and retrospective precede uncommitted publication to the project folder.",
        "ticketWorkflowId":  "ticket-delivery",
        "maxConcurrentTickets":  2,
        "participants":  [
                             "lead",
                             "acceptance-tester",
                             "retrospective-analyst"
                         ],
        "initial":  "dispatch_tickets",
        "maxAutomaticExchanges":  null,
        "states":  {
                       "dispatch_tickets":  {
                                                "type":  "operation",
                                                "executor":  "deliver-tickets",
                                                "inputs":  [
                                                               "task",
                                                               "project",
                                                               "epic"
                                                           ],
                                                "on":  {
                                                           "wave_ready":  {
                                                                              "target":  "integrate",
                                                                              "outputs":  {
                                                                                              "integration_status":  "document"
                                                                                          }
                                                                          },
                                                           "all_done":  {
                                                                            "target":  "acceptance",
                                                                            "outputs":  {
                                                                                            "delivery_candidate":  "candidate",
                                                                                            "delivery_tickets":  "tickets",
                                                                                            "acceptance_criteria":  "criteria"
                                                                                        }
                                                                        },
                                                           "blocked":  {
                                                                           "target":  "await_tickets",
                                                                           "guard":  "questions",
                                                                           "outputs":  {
                                                                                           "questions":  "questions"
                                                                                       }
                                                                       }
                                                       }
                                            },
                       "await_tickets":  {
                                             "type":  "human",
                                             "inputs":  [
                                                            "questions"
                                                        ],
                                             "instructions":  "Ticket workflows need direction. Open their tasks for specific questions or provide direction here for the blocked ticket workflows.",
                                             "on":  {
                                                        "children_ready": {"target":"dispatch_tickets","clear":["questions"]},
                                                        "answered":  {
                                                                         "target":  "dispatch_tickets",
                                                                         "outputs":  {
                                                                                         "answers":  "answer"
                                                                                     },
                                                                         "clear":  [
                                                                                       "questions"
                                                                                   ]
                                                                     }
                                                    }
                                         },
                       "integrate":  {
                                         "type":  "agent",
                                         "persona":  "lead",
                                         "executor":  "integrate-tickets",
                                         "instructions":  "Own integration of the independently reviewed ticket worktrees. Inspect the combined candidate and predecessor diff, all supplied ticket scope, and actual independent verification receipts. Return integrated only if the combined behavior and preservation are sound. Use changes for a concrete defect; the configured ticket team will repair and independently review the whole combined scope. Use technical_blocker for an environment/capability blocker. Keep source read-only; the runner applies approved Git integration.",
                                         "inputs":  [
                                                        "task",
                                                        "project",
                                                        "epic"
                                                    ],
                                         "optionalInputs":  [
                                                                "integration_plan",
                                                                "integration_findings",
                                                                "answers"
                                                            ],
                                         "on":  {
                                                    "integrated":  {
                                                                       "target":  "dispatch_tickets",
                                                                       "outputs":  {
                                                                                       "integration_review":  "document"
                                                                                   }
                                                                   },
                                                    "changes":  {
                                                                    "target":  "dispatch_tickets",
                                                                    "outputs":  {
                                                                                    "integration_findings":  "document"
                                                                                }
                                                                },
                                                    "repair_started":  {
                                                                           "target":  "dispatch_tickets",
                                                                           "outputs":  {
                                                                                           "integration_findings":  "document"
                                                                                       }
                                                                       },
                                                    "technical_blocker":  {
                                                                              "target":  "resolve_delivery",
                                                                              "remember":  true,
                                                                              "guard":  "questions",
                                                                              "outputs":  {
                                                                                              "questions":  "questions",
                                                                                              "integration_findings":  "document"
                                                                                          }
                                                                          }
                                                }
                                     },
                       "acceptance":  {
                                          "type":  "agent",
                                          "persona":  "acceptance-tester",
                                          "executor":  "acceptance",
                                          "instructions":  "Exercise the assembled epic\u0027s user-visible acceptance criteria against the supplied exact candidate. Use the available project tools and verification receipts; report passed, failed or unverified criteria with evidence. Return acceptance_passed only when all assigned criteria pass, changes for reproducible defects, or blocked for missing tools/environment. Keep source unchanged.",
                                          "inputs":  [
                                                         "task",
                                                         "project",
                                                         "epic",
                                                         "delivery_candidate",
                                                         "delivery_tickets",
                                                         "acceptance_criteria"
                                                     ],
                                          "optionalInputs":  [
                                                                 "answers",
                                                                 "acceptance_report",
                                                                 "resolution"
                                                             ],
                                          "on":  {
                                                     "acceptance_passed":  {
                                                                               "target":  "retrospective",
                                                                               "guard":  "acceptance",
                                                                               "outputs":  {
                                                                                               "acceptance_report":  "document",
                                                                                               "acceptance_candidate":  "candidate"
                                                                                           }
                                                                           },
                                                     "changes":  {
                                                                     "target":  "reopen_ticket",
                                                                     "outputs":  {
                                                                                     "acceptance_report":  "document"
                                                                                 }
                                                                 },
                                                     "blocked":  {
                                                                     "target":  "await_acceptance",
                                                                     "outputs":  {
                                                                                     "questions":  "questions",
                                                                                     "acceptance_report":  "document"
                                                                                 }
                                                                 },
                                                     "technical_blocker":  {
                                                                               "target":  "resolve_delivery",
                                                                               "remember":  true,
                                                                               "guard":  "questions",
                                                                               "outputs":  {
                                                                                               "questions":  "questions",
                                                                                               "acceptance_report":  "document"
                                                                                           }
                                                                           }
                                                 }
                                      },
                       "await_acceptance":  {
                                                "type":  "human",
                                                "instructions":  "Acceptance needs an environment or capability resolution. Answer to retry acceptance; a response alone does not pass it.",
                                                "inputs":  [
                                                               "questions",
                                                               "acceptance_report"
                                                           ],
                                                "on":  {
                                                           "answered":  {
                                                                            "target":  "acceptance",
                                                                            "outputs":  {
                                                                                            "answers":  "answer"
                                                                                        },
                                                                            "clear":  [
                                                                                          "questions"
                                                                                      ]
                                                                        }
                                                       }
                                            },
                       "reopen_ticket":  {
                                             "type":  "operation",
                                             "executor":  "reopen-ticket",
                                             "inputs":  [
                                                            "acceptance_report",
                                                            "delivery_candidate"
                                                        ],
                                             "on":  {
                                                        "repair_started":  {
                                                                               "target":  "dispatch_tickets",
                                                                               "outputs":  {
                                                                                               "integration_findings":  "document"
                                                                                           },
                                                                               "clear":  [
                                                                                             "delivery_candidate",
                                                                                             "acceptance_candidate",
                                                                                             "retrospective",
                                                                                             "questions"
                                                                                         ]
                                                                           }
                                                    }
                                         },
                       "retrospective":  {
                                             "type":  "agent",
                                             "persona":  "retrospective-analyst",
                                             "executor":  "retrospective",
                                             "instructions":  "Apply retro to the supplied primary execution evidence. Propose evidence-backed improvements to navigation, deterministic checks, review standards and agent instructions. Return retrospective_ready with recommendations, or an explicit no-change conclusion. Keep proposals distinct from adopted changes.",
                                             "inputs":  [
                                                            "task",
                                                            "project",
                                                            "epic",
                                                            "acceptance_report",
                                                            "acceptance_candidate",
                                                            "execution_evidence"
                                                        ],
                                             "optionalInputs":  [
                                                                    "resolution",
                                                                    "answers"
                                                                ],
                                             "on":  {
                                                        "retrospective_ready":  {
                                                                                    "target":  "publish_source",
                                                                                    "guard":  "document",
                                                                                    "outputs":  {
                                                                                                    "retrospective":  "document"
                                                                                                }
                                                                                },
                                                        "technical_blocker":  {
                                                                                  "target":  "resolve_delivery",
                                                                                  "remember":  true,
                                                                                  "guard":  "questions",
                                                                                  "outputs":  {
                                                                                                  "questions":  "questions"
                                                                                              }
                                                                              }
                                                    }
                                         },
                       "resolve_delivery":  {
                                                "type":  "agent",
                                                "persona":  "lead",
                                                "executor":  "resolve-delivery",
                                                "attemptLimit":  1,
                                                "instructions":  "Resolve the repeated acceptance or retrospective command failure from its retained receipts within current scope. Work read-only against the exact delivered candidate. Return resolved with an actionable resolution for the saved state, or blocked with a concrete user question for missing capabilities or authority. Source changes require a separately reviewed Builder repair.",
                                                "inputs":  [
                                                               "task",
                                                               "project",
                                                               "epic",
                                                               "questions",
                                                               "execution_evidence"
                                                           ],
                                                "on":  {
                                                           "resolved":  {
                                                                            "target":  "$resume",
                                                                            "outputs":  {
                                                                                            "resolution":  "document"
                                                                                        },
                                                                            "clear":  [
                                                                                          "questions"
                                                                                      ]
                                                                        },
                                                           "blocked":  {
                                                                           "target":  "await_delivery_resolution",
                                                                           "guard":  "questions",
                                                                           "outputs":  {
                                                                                           "questions":  "questions"
                                                                                       }
                                                                       }
                                                       },
                                                "optionalInputs":  [
                                                                       "integration_plan",
                                                                       "integration_findings",
                                                                       "delivery_candidate"
                                                                   ]
                                            },
                       "await_delivery_resolution":  {
                                                         "type":  "human",
                                                         "instructions":  "Workflow-level Lead recovery needs your resolution. The answer retries the saved state without passing acceptance automatically.",
                                                         "inputs":  [
                                                                        "questions"
                                                                    ],
                                                         "on":  {
                                                                    "answered":  {
                                                                                     "target":  "$resume",
                                                                                     "outputs":  {
                                                                                                     "answers":  "answer"
                                                                                                 },
                                                                                     "clear":  [
                                                                                                   "questions"
                                                                                               ]
                                                                                 }
                                                                }
                                                     },
                       "publish_source":  {
                                              "type":  "operation",
                                              "executor":  "publish-source",
                                              "inputs":  [
                                                             "acceptance_candidate",
                                                             "retrospective"
                                                         ],
                                              "on":  {
                                                         "published":  {
                                                                           "target":  "complete",
                                                                           "outputs":  {
                                                                                           "publication":  "publication"
                                                                                       }
                                                                       },
                                                         "blocked":  {
                                                                         "target":  "await_publication",
                                                                         "guard":  "questions",
                                                                         "outputs":  {
                                                                                         "questions":  "questions",
                                                                                         "publication_report":  "document"
                                                                                     }
                                                                     }
                                                     }
                                          },
                       "await_publication":  {
                                                 "type":  "human",
                                                 "inputs":  [
                                                                "questions",
                                                                "publication_report"
                                                            ],
                                                 "instructions":  "Project files changed or could not be written. Resolve the named conflicts, then retry. Existing edits are preserved; the runner does not force an overwrite.",
                                                 "on":  {
                                                            "answered":  {
                                                                             "target":  "publish_source",
                                                                             "outputs":  {
                                                                                             "answers":  "answer"
                                                                                         },
                                                                             "clear":  [
                                                                                           "questions"
                                                                                       ]
                                                                         }
                                                        }
                                             },
                       "complete":  {
                                        "type":  "final",
                                        "requires":  [
                                                         "acceptance_candidate",
                                                         "acceptance_report",
                                                         "retrospective",
                                                         "publication"
                                                     ],
                                        "message":  "Ticket worktrees passed review and Lead integration. Final acceptance passed, and accepted source is in the configured project folder as uncommitted changes."
                                    }
                   }
    },
    {
        "schemaVersion":  2,
        "id":  "ticket-delivery",
        "name":  "Delivery ticket stages",
        "kind":  "delivery",
        "internal":  true,
        "description":  "Parent-owned ticket workflow: Lead, BA, Builder, independent Reviewer and bounded recovery.",
        "participants":  [
                             "lead",
                             "ba",
                             "builder",
                             "reviewer"
                         ],
        "initial":  "triage",
        "maxAutomaticExchanges":  null,
        "states":  {
                       "triage":  {
                                      "type":  "agent",
                                      "persona":  "lead",
                                      "executor":  "ticket",
                                      "role":  "lead",
                                      "instructions":  "Assess this ticket against the epic goal and hand it to the BA for readiness verification.",
                                      "inputs":  [
                                                     "task",
                                                     "project",
                                                     "epic",
                                                     "ticket"
                                                 ],
                                      "on":  {
                                                 "ready":  {
                                                               "target":  "refine",
                                                               "outputs":  {
                                                                               "lead_assessment":  "document"
                                                                           }
                                                           },
                                                 "refine":  {
                                                                "target":  "refine",
                                                                "outputs":  {
                                                                                "lead_assessment":  "document"
                                                                            }
                                                            },
                                                 "technical_blocker":  {
                                                                           "target":  "resolve_technical",
                                                                           "remember":  true,
                                                                           "outputs":  {
                                                                                           "questions":  "questions"
                                                                                       }
                                                                       },
                                                 "blocked":  {
                                                                 "target":  "await_resolution",
                                                                 "remember":  true,
                                                                 "outputs":  {
                                                                                 "questions":  "questions"
                                                                             }
                                                             }
                                             },
                                      "parallelism":  8
                                  },
                       "refine":  {
                                      "type":  "agent",
                                      "persona":  "ba",
                                      "executor":  "ticket",
                                      "role":  "ba",
                                      "instructions":  "Verify scope, acceptance criteria, dependencies and verification readiness before implementation.",
                                      "inputs":  [
                                                     "task",
                                                     "project",
                                                     "epic",
                                                     "ticket",
                                                     "lead_assessment"
                                                 ],
                                      "on":  {
                                                 "refined":  {
                                                                 "target":  "build",
                                                                 "outputs":  {
                                                                                 "implementation_plan":  "document"
                                                                             }
                                                             },
                                                 "technical_blocker":  {
                                                                           "target":  "resolve_technical",
                                                                           "remember":  true,
                                                                           "outputs":  {
                                                                                           "questions":  "questions"
                                                                                       }
                                                                       },
                                                 "blocked":  {
                                                                 "target":  "await_resolution",
                                                                 "remember":  true,
                                                                 "outputs":  {
                                                                                 "questions":  "questions"
                                                                             }
                                                             }
                                             },
                                      "parallelism":  8
                                  },
                       "build":  {
                                     "type":  "agent",
                                     "persona":  "builder",
                                     "executor":  "ticket",
                                     "role":  "builder",
                                     "instructions":  "Apply implement/tdd at the accepted seams: establish a failing behavior test, implement the minimum green slice, preserve predecessor behavior and run the required checks. Report commands/results and limitations. Supply meaningful verification for a new project. The runner schedules independent review.",
                                     "inputs":  [
                                                    "task",
                                                    "project",
                                                    "epic",
                                                    "ticket",
                                                    "implementation_plan"
                                                ],
                                     "optionalInputs":  [
                                                            "review_findings",
                                                            "answers"
                                                        ],
                                     "on":  {
                                                "implemented":  {
                                                                    "target":  "review",
                                                                    "guard":  "verified",
                                                                    "outputs":  {
                                                                                    "candidate":  "candidate"
                                                                                }
                                                                },
                                                "technical_blocker":  {
                                                                          "target":  "resolve_technical",
                                                                          "remember":  true,
                                                                          "outputs":  {
                                                                                          "questions":  "questions"
                                                                                      }
                                                                      },
                                                "blocked":  {
                                                                "target":  "await_resolution",
                                                                "remember":  true,
                                                                "outputs":  {
                                                                                "questions":  "questions"
                                                                            }
                                                            }
                                            },
                                     "parallelism":  8
                                 },
                       "review":  {
                                      "type":  "agent",
                                      "persona":  "reviewer",
                                      "executor":  "ticket",
                                      "role":  "reviewer",
                                      "instructions":  "Apply code-review to the exact verified candidate. Report Standards and Spec verdicts separately, with actionable findings and regression evidence. Approve only when acceptance criteria and preserved earlier behavior pass. The runner owns any separate review assignments.",
                                      "inputs":  [
                                                     "task",
                                                     "project",
                                                     "epic",
                                                     "ticket",
                                                     "candidate"
                                                 ],
                                      "on":  {
                                                 "approved":  {
                                                                  "target":  "accept_ticket",
                                                                  "guard":  "approved",
                                                                  "outputs":  {
                                                                                  "review_findings":  "document"
                                                                              }
                                                              },
                                                 "changes":  {
                                                                 "target":  "build",
                                                                 "outputs":  {
                                                                                 "review_findings":  "document"
                                                                             }
                                                             },
                                                 "technical_blocker":  {
                                                                           "target":  "resolve_technical",
                                                                           "remember":  true,
                                                                           "outputs":  {
                                                                                           "questions":  "questions"
                                                                                       }
                                                                       },
                                                 "blocked":  {
                                                                 "target":  "await_resolution",
                                                                 "remember":  true,
                                                                 "outputs":  {
                                                                                 "questions":  "questions"
                                                                             }
                                                             },
                                                 "source_changed":  "build"
                                             },
                                      "parallelism":  8
                                  },
                       "resolve_technical":  {
                                                 "type":  "agent",
                                                 "persona":  "lead",
                                                 "executor":  "resolve-technical",
                                                 "role":  "lead",
                                                 "attemptLimit":  1,
                                                 "instructions":  "Resolve the routine technical blocker within current scope. Escalate product/authority decisions or exhausted recovery to the user.",
                                                 "inputs":  [
                                                                "task",
                                                                "project",
                                                                "epic",
                                                                "ticket",
                                                                "questions"
                                                            ],
                                                 "on":  {
                                                            "resolved":  {
                                                                             "target":  "$resume",
                                                                             "outputs":  {
                                                                                             "resolution":  "document"
                                                                                         }
                                                                         },
                                                            "blocked":  {
                                                                            "target":  "await_resolution",
                                                                            "outputs":  {
                                                                                            "questions":  "questions"
                                                                                        }
                                                                        }
                                                        },
                                                 "parallelism":  8
                                             },
                       "await_resolution":  {
                                                "type":  "human",
                                                "inputs":  [
                                                               "questions"
                                                           ],
                                                "instructions":  "The ticket needs your resolution before continuing.",
                                                "on":  {
                                                           "answered":  {
                                                                            "target":  "$resume",
                                                                            "outputs":  {
                                                                                            "answers":  "answer"
                                                                                        }
                                                                        },
                                                           "source_changed":  {
                                                                                  "target":  "build",
                                                                                  "outputs":  {
                                                                                                  "answers":  "answer"
                                                                                              }
                                                                              }
                                                       }
                                            },
                       "accept_ticket":  {
                                             "type":  "operation",
                                             "executor":  "accept-ticket",
                                             "inputs":  [
                                                            "ticket",
                                                            "candidate",
                                                            "review_findings"
                                                        ],
                                             "on":  {
                                                        "accepted":  "ticket_complete"
                                                    }
                                         },
                       "ticket_complete":  {
                                               "type":  "final",
                                               "requires":  [
                                                                "candidate",
                                                                "review_findings"
                                                            ],
                                               "message":  "Ticket passed independent review; its parent owns combined-source integration."
                                           }
                   }
    }
]